# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/course_enrollment_db

# JWT Secret key for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Frontend Deployed URL for CORS Configuration (in development, localhost is auto-allowed)
FRONTEND_URL=http://localhost:5173

# Demo Admin Seed Configuration
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
